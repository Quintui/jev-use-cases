# Jev via OpenRouter (typesafe/jev-1.13). Also streams the Segment 4 answer.
OPENROUTER_API_KEY=
# Alternatives, used in this order if OpenRouter isn't set:
# a direct TypeSafe key, then the Vercel AI Gateway.
TYPESAFE_AI_API_KEY=
AI_GATEWAY_API_KEY=
# Optional overrides
# JEV_MODEL=typesafe/jev-1.13   (use ~typesafe/jev-latest to track the newest release)
# RESPONSE_MODEL=anthropic/claude-haiku-4.5
